{
  "schema_version": 1,
  "purpose": "module3_lab_observation_only",
  "roi_source": "new_provisional_laboratory_grid_NOT_dashcam_dataset",
  "road_calibrated": false,
  "transform": "identity",
  "main_size": [1920, 1080],
  "lores_size": [320, 180],
