    "enter_detect_kmh": 9,
    "enter_view_kmh": 11,
    "mode_dwell_ns": 2000000000,
    "status_dwell_ns": 200000000,
    "max_speed_age_ns": 1000000000,
    "max_frame_age_ns": 500000000,
    "command_timeout_ns": 1000000000,
    "min_response": 0.8,
    "max_response": 1.25,
    "highlight_pct": 1
