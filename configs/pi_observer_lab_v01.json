  "capture_timeout_s": 2,
  "max_output_bytes": 20000000,
  "reserve_bytes": 1000000000,
  "snapshot_max_bytes": 3000000,
  "snapshot_at_s": [0, 7, 14],
  "simulated_speed_kmh": 8,
  "diagnostic_analysis": {"dark_y": 32, "clipped_y": 235, "metering_percentile": 50, "min_zone_pixels": 16},
  "laboratory_metering_rectangle": [0.15, 0.25, 0.85, 0.75],
  "policy": {
    "version": "pi-observer-lab-001-NOT-calibrated",
    "detect": {"min_exposure_us": 100, "max_exposure_us": 4000, "preferred_exposure_us": 4000, "target_y": 100, "band_fraction": 0.15},
